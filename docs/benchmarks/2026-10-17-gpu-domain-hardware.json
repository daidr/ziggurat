  "workload": "one fill and sixteen draws of one explicitly uploaded 256x256 premultiplied BGRA texture per 320x180 render target, scale 1",
  "setup_scope": "Domain creation and upload through first native begin/replay/end in every window; excludes App/source/command-storage construction",
  "timing_scope": "CPU wall time for a round of begin/replay/end submissions, including busy/occluded Present; no fence, readback, event-loop wait or display-latency measurement",
  "memory_scope": "whole-process samples; includes driver and OS caches and the benchmark harness; after is before App/source/harness allocator teardown; logical reservations are separate",
  "allocator_scope": "explicit Zig allocator calls only; native libraries and driver allocations are not intercepted",
  "ordering": "shared first on even trials, isolated first on odd trials; all trials in one process, so setup is not a clean process/driver cold-start comparison",
